quiet() {
  :
}

require() {
  echo "- required"
}

require--with-args() {
  echo "- required #$1"
}

one-dependent() {
  @require: require

  echo "- dependent"
}

one-dependent--subprocess() (
  @require: require

  echo "- dependent"
)

one-dependent--missing() {
  @require: missing

  echo "- dependent"
}

multi-dependent() {
  @require: require require require

  echo "- dependent"
}

multi-dependent--subprocess() (
  @require: require require require

  echo "- dependent"
)

multi-dependent--missing() (
  @require: quiet missing require

  echo "- dependent"
)

multi-dependent--with-args() {
  @require: "require--with-args 1" "require--with-args 2" "require--with-args 3"

  echo "- dependent"
}
