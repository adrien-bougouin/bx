BIN_PATH="$(realpath ./bin)"
readonly BIN_PATH

# shellcheck disable=SC2207
SOURCES=(./bin/bake $(find ./src -name "*.sh") ./tests/*.sh)
readonly SOURCES

# shellcheck disable=SC2207
TESTS=($(find ./tests/cases -name "test_*.sh"))
readonly TESTS

# shellcheck disable=SC2207
BAKEFILES=(./Bakefile $(find ./tests/bakefiles -name "Bakefile") $(find ./tests/bakefiles -name "*.bakefile"))
readonly BAKEFILES

# Install bake
install() (
  echo "Run command \`export PATH=${BIN_PATH}:\${PATH}\`"
)

# Run bash linting
lint() (
  local args=("--exclude" "SC1090,SC1091,SC2329" "$@")

  set -x

  shellcheck ${args+"${args[@]}"} "${SOURCES[@]}"
  shellcheck ${args+"${args[@]}"} "${TESTS[@]}"
  shellcheck --shell bash ${args+"${args[@]}"} "${BAKEFILES[@]}"
)

format() (
  set -x

  # https://google.github.io/styleguide/shellguide.html
  shfmt -i 2 -ci -bn -s -w "${SOURCES[@]}"
  shfmt -i 2 -ci -bn -s -w "${BAKEFILES[@]}"
  shfmt -ci -bn -s -w "${TESTS[@]}"
)

tests() (
  PATH="${BIN_PATH}:${PATH}"

  ./tests/main.sh "${1:-"${TESTS[@]}"}"
)
