ROOT_PATH="$(realpath "$(dirname "${BASH_SOURCE[0]}")")"

BIN_PATH="${ROOT_PATH}/bin"
SOURCE_PATH="${ROOT_PATH}/src"
FEATURE_PATH="${ROOT_PATH}/features"

# shellcheck disable=SC2207
SOURCES=("${BIN_PATH}/bake" $(find "${SOURCE_PATH}" -name "*.sh"))

dist() {
  @help "Prepare downloadable Bake archive and installer." \
    "Arguments:" \
    "  download_host - URI of the location where the distribution archive" \
    "                  will be stored (default: file://<repo_path>/dist)."

  bake::invoke clean-dist

  local bake_name="${__BAKE_CONSTANT_COMMAND_NAME__}"
  local bake_version="${__BAKE_CONSTANT_VERSION__}"
  local bake_dirname="${bake_name}_${bake_version}"
  local bake_archive_name="${bake_dirname}.tar.gz"

  local dist_path="${ROOT_PATH}/dist"
  local dist_bake_path="${dist_path}/${bake_dirname}"
  local bake_archive_path="${dist_bake_path}.tar.gz"

  local dist_src_path
  local dist_bin_path

  dist_src_path="${dist_bake_path}/$(basename "${SOURCE_PATH}")"
  dist_bin_path="${dist_bake_path}/$(basename "${BIN_PATH}")"

  local download_host="${1:-file://${dist_path}}"
  download_host="${download_host%/}"

  local checksum

  set -x

  mkdir -p "${dist_bin_path}"

  cp -r "${ROOT_PATH}/Bakefile" \
    "${dist_bake_path}/Bakefile"
  cp -r "${SOURCE_PATH}" \
    "${dist_src_path}"
  cp -r "${BIN_PATH}/${bake_name}" \
    "${dist_bin_path}/${bake_name}"

  tar -czf "${bake_archive_path}" -C "${dist_path}" "${bake_dirname}"

  # shellcheck disable=SC2207
  checksum=($(_checksum "${bake_archive_path}"))

  sed \
    -e "s/{{DOWNLOAD_HOST}}/${download_host//\//\\/}/g" \
    -e "s/^BAKE_VERSION=\$/BAKE_VERSION=${bake_version}/" \
    -e "s/^BAKE_TARBALL_URL=\$/BAKE_TARBALL_URL=${download_host//\//\\/}\/${bake_archive_name//\//\\/}/" \
    -e "s/^BAKE_TARBALL_SHA256=\$/BAKE_TARBALL_SHA256=${checksum[0]}/" \
    "${ROOT_PATH}/install.sh" \
    >"${dist_path}/install.sh"
}

clean-dist() {
  set -x

  rm -rf "${ROOT_PATH}/dist"
}

install() {
  @help "Add '${BIN_PATH/#${HOME}/~}' to binary path from shell config." \
    "Supported shells: sh, dash, bash, zsh, and fish."

  if command -v "${__BAKE_CONSTANT_COMMAND_NAME__}" &>/dev/null; then
    echo "${__BAKE_CONSTANT_COMMAND_NAME__} is already installed!" >&2

    exit 1
  fi

  local shell
  local config_path
  local config_content
  local apply_instruction

  shell="$(basename "${SHELL}")"

  case "${shell}" in
    sh | dash)
      config_path="${HOME}/.profile"
      config_content="export PATH=${BIN_PATH}:\${PATH}"
      apply_instruction="export PATH=\"${BIN_PATH}:\${PATH}\""
      ;;

    bash | zsh)
      config_path="${HOME}/.${shell}rc"
      config_content="export PATH=${BIN_PATH}:\${PATH}"
      apply_instruction="export PATH=\"${BIN_PATH}:\${PATH}\""
      ;;

    fish)
      config_path="${HOME}/.config/fish/config.fish"
      config_content="fish_add_path ${BIN_PATH}"
      apply_instruction="fish_add_path \"${BIN_PATH}\""
      ;;

    *)
      echo "Installing to shell '${shell}' is not supported!" >&2

      exit 1
      ;;
  esac

  if ! grep -qsxF "${config_content}" "${config_path}" 2>/dev/null; then
    printf "\n%s" "${config_content}" >>"${config_path}"
  fi

  cat <<-INFO
		${__BAKE_CONSTANT_COMMAND_NAME__} is installed in ${config_path}

		Execute this in your terminal to use ${__BAKE_CONSTANT_COMMAND_NAME__} right now:
		  ${apply_instruction}
	INFO
}

# Execute bash linting
lint() {
  local args=("--exclude" "SC1090,SC1091,SC2030,SC2031,SC2329" "$@")

  set -x

  shellcheck --shell bash ${args+"${args[@]}"} "${SOURCES[@]}" "${ROOT_PATH}/install.sh" "${ROOT_PATH}/Bakefile"
}

format() {
  set -x

  # https://google.github.io/styleguide/shellguide.html
  shfmt -i 2 -ci -bn -s -w "${SOURCES[@]}" "${ROOT_PATH}/install.sh" "${ROOT_PATH}/Bakefile"
}

todo-list() {
  bake::invoke 'features-check --tags="@skip or @fixme or @todo"'
}

features-check() {
  _cucumber-env

  export PATH="${BIN_PATH}:${PATH}"

  local args=("$@")
  local skip_args=()

  if [[ ! $* =~ "--tags" ]]; then
    skip_args+=("--tags" "not @skip")
  fi

  set -x

  bundle exec cucumber --no-source ${skip_args+"${skip_args[@]}"} ${args+"${args[@]}"} --require "${FEATURE_PATH}" "${FEATURE_PATH}"
}

cucumber-lint() {
  _cucumber-env

  local args=("$@")

  set -x

  bundle exec rubocop ${args+"${args[@]}"}
}

_checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1"
  else
    shasum -a 256 "$1"
  fi
}

_cucumber-env() {
  RBENV_VERSION="$(cat "${FEATURE_PATH}/.ruby-version")"
  BUNDLE_GEMFILE="${FEATURE_PATH}/Gemfile"
  CUCUMBER_PUBLISH_QUIET="true"
  RUBOCOP_OPTS="--config ${FEATURE_PATH}/.rubocop.yml"

  export RBENV_VERSION
  export BUNDLE_GEMFILE
  export CUCUMBER_PUBLISH_QUIET
  export RUBOCOP_OPTS

  (set -x && bundle install >/dev/null)
}
