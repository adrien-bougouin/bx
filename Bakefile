BIN_PATH="$(realpath ./bin)"

# shellcheck disable=SC2207
SOURCES=(./bin/bake $(find ./src -name "*.sh") ./tests/*.sh)

# shellcheck disable=SC2207
TESTS=($(find ./tests/cases -name "test_*.sh"))

# shellcheck disable=SC2207
BAKEFILES=(./Bakefile $(find ./tests/bakefiles -name "Bakefile") $(find ./tests/bakefiles -name "*.bakefile"))

# Install bake
install() (
  if command -v "${__BAKE_CONSTANT_COMMAND_NAME__}" &>/dev/null; then
    echo "bake is already installed!" >&2

    exit 1
  fi

  local shell
  local config_path
  local config_content
  local apply_instruction

  shell="$(basename "${SHELL}")"

  case "${shell}" in
    sh | dash)
      config_path="${HOME}/.profile"
      config_content="export PATH=${BIN_PATH}:\${PATH}"
      apply_instruction="export PATH=\"${BIN_PATH}:\${PATH}\""
      ;;

    bash | zsh)
      config_path="${HOME}/.${shell}rc"
      config_content="export PATH=${BIN_PATH}:\${PATH}"
      apply_instruction="export PATH=\"${BIN_PATH}:\${PATH}\""
      ;;

    fish)
      config_path="${HOME}/.config/fish/config.fish"
      config_content="fish_add_path ${BIN_PATH}"
      apply_instruction="fish_add_path \"${BIN_PATH}\""
      ;;

    *)
      echo "Installing to shell '${shell}' is not supported!" >&2

      exit 1
      ;;
  esac

  if ! grep -qsxF "${config_content}" "${config_path}" 2>/dev/null; then
    printf "\n%s" "${config_content}" >>"${config_path}"
  fi

  cat <<-INFO
		${__BAKE_CONSTANT_COMMAND_NAME__} is installed in ${config_path}

		Run this in your terminal to use ${__BAKE_CONSTANT_COMMAND_NAME__} right now:
		  ${apply_instruction}
	INFO
)

# Run bash linting
lint() (
  local args=("--exclude" "SC1090,SC1091,SC2329" "$@")

  set -x

  shellcheck ${args+"${args[@]}"} "${SOURCES[@]}"
  shellcheck ${args+"${args[@]}"} "${TESTS[@]}"
  shellcheck --shell bash ${args+"${args[@]}"} "${BAKEFILES[@]}"
)

format() (
  set -x

  # https://google.github.io/styleguide/shellguide.html
  shfmt -i 2 -ci -bn -s -w "${SOURCES[@]}"
  shfmt -i 2 -ci -bn -s -w "${BAKEFILES[@]}"
  shfmt -ci -bn -s -w "${TESTS[@]}"
)

tests() (
  PATH="${BIN_PATH}:${PATH}"

  ./tests/main.sh "${1:-"${TESTS[@]}"}"

)
