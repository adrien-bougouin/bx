readonly SOURCES=(./bin/bake ./src/** ./test/run.sh)
readonly TESTS=(./test/test_*.sh)
readonly BAKEFILES=(./Bakefile ./**/Bakefile)

noop() (
  @default
  @file: "noop.txt"

  echo "NOOP"
)

# Install bake
install() (
  echo "Run command \`export PATH=${__BAKE_BIN_DIR__}:\${PATH}\`"
)

# Run bash linting
lint() (
  @require: format

  local args=("$@")

  set -x

  shellcheck ${args+"${args[@]}"} "${SOURCES[@]}"
  shellcheck ${args+"${args[@]}"} "${TESTS[@]}"
  shellcheck --shell bash ${args+"${args[@]}"} "${BAKEFILES[@]}"
)

format() (
  set -x

  # https://google.github.io/styleguide/shellguide.html
  shfmt -i 2 -ci -bn -s -w "${SOURCES[@]}" "${BAKEFILES[@]}"
  shfmt -ci -bn -s -w "${TESTS[@]}"
)

tests() (
  PATH="${__BAKE_BIN_DIR__}:${PATH}"

  cd test && ./run.sh ./test_*.sh
)
