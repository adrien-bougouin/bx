BIN_DIR="$(realpath ./bin)"
SOURCES=(./bin/bake ./src/** ./tests/main.sh)
TESTS=(./tests/test_*.sh)
BAKEFILES=(./Bakefile ./tests/bakefiles/*.bakefile)

readonly BIN_DIR
readonly SOURCES
readonly TESTS
readonly BAKEFILES

# Install bake
install() (
  echo "Run command \`export PATH=${BIN_DIR}:\${PATH}\`"
)

# Run bash linting
lint() (
  local args=("--exclude" "SC1090,SC1091,SC2329" "$@")

  set -x

  shellcheck ${args+"${args[@]}"} "${SOURCES[@]}"
  shellcheck ${args+"${args[@]}"} "${TESTS[@]}"
  shellcheck --shell bash ${args+"${args[@]}"} "${BAKEFILES[@]}"
)

format() (
  set -x

  # https://google.github.io/styleguide/shellguide.html
  shfmt -i 2 -ci -bn -s -w "${SOURCES[@]}"
  shfmt -i 2 -ci -bn -s -w "${BAKEFILES[@]}"
  shfmt -ci -bn -s -w "${TESTS[@]}"
)

tests() (
  PATH="${BIN_DIR}:${PATH}"

  ./tests/main.sh "${TESTS[@]}"
)
