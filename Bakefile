noop () { @default; @as "noop.txt"
  set -x

  echo "NOOP"
}

# Run bash linting
lint () { @from "noop.txt"
  local args=("$@")
  local sources=(./bin/bake ./lib/**)

  set -x

  shellcheck ${args+"${args[@]}"} "${sources[@]}"
  shellcheck --shell bash ${args+"${args[@]}"} ./Bakefile
}

