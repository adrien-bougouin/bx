readonly SOURCES=(./bin/bake ./src/**)

noop() (
  @default
  @file: "noop.txt"

  echo "NOOP"
)

# Install bake
install() (
  echo "Run command \`export PATH=${__BAKE_BINS__}:\${PATH}\`"
)

# Run bash linting
lint() (
  @require: format

  local args=("$@")

  set -x

  shellcheck ${args+"${args[@]}"} "${SOURCES[@]}"
  shellcheck --shell bash ${args+"${args[@]}"} ./Bakefile
)

format() (
  set -x

  # https://google.github.io/styleguide/shellguide.html
  shfmt -i 2 -ci -bn -s -w "${SOURCES[@]}" ./Bakefile
)

tests() (
  # TODO: run test scenarios
  true
)
