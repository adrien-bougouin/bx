ROOT_PATH="$(realpath "$(dirname "${BASH_SOURCE[0]}")")"

BIN_PATH="${ROOT_PATH}/bin"
MAN_PATH="${ROOT_PATH}/man"
SRC_PATH="${ROOT_PATH}/src"

# shellcheck disable=SC2207
SOURCES=($(find "${BIN_PATH}" -name "bx*") $(find "${SRC_PATH}" -name "*.sh"))
BASHFILES=("${ROOT_PATH}/Bashfile" "${ROOT_PATH}/dist.bashfile" "${ROOT_PATH}/features/Bashfile")
DIST_SCRIPTS=("${ROOT_PATH}/install.sh")

source "${ROOT_PATH}/dist.bashfile"
source "${ROOT_PATH}/features/Bashfile"

doctor() {
  @help "Check for requirements to develop bx."

  local failures=0

  _doctor::check "Bash 3.2 or above" \
    /usr/bin/env bash -c '((BASH_VERSINFO[0] > 3 || (BASH_VERSINFO[0] == 3 && BASH_VERSINFO[1] >= 2)))' \
    || failures=$((failures + 1))

  _doctor::check "shfmt" command -v shfmt || failures=$((failures + 1))
  _doctor::check "ShellCheck" command -v shellcheck || failures=$((failures + 1))
  _doctor::check "mandoc" command -v mandoc || failures=$((failures + 1))

  if [[ ${failures} -gt 0 ]]; then
    printf "\n%s\n" "Missing requirements for developing bx!"

    return 1
  fi
}

format() {
  set -x

  # https://google.github.io/styleguide/shellguide.html
  shfmt -i 2 -ci -bn -s -w "${SOURCES[@]}" "${BASHFILES[@]}" "${DIST_SCRIPTS[@]}"
}

lint() {
  local args=("--exclude" "SC1090,SC1091,SC2030,SC2031,SC2329" "$@")

  set -x

  shellcheck --shell bash ${args+"${args[@]}"} "${SOURCES[@]}" "${BASHFILES[@]}" "${DIST_SCRIPTS[@]}"
}

man::lint() {
  set -x

  mandoc -T lint "${MAN_PATH}"/*/*
}

dist() {
  @help \
    "Prepare downloadable bx archive and installer." \
    "Arguments:" \
    "    download_host - URI of the location where the distribution archive" \
    "                    will be stored (default: file://<repo_path>/dist)."

  bx::invoke clean-dist

  local bx_name="${__BX_CONSTANT_COMMAND_NAME__}"
  local bx_version="${__BX_CONSTANT_VERSION__}"
  local bx_dirname="${bx_name}_${bx_version}"

  local dist_path="${ROOT_PATH}/dist"
  local dist_bx_path="${dist_path}/${bx_dirname}"
  local bx_archive_path="${dist_bx_path}.tar.gz"

  local dist_bin_path
  local dist_man_path
  local dist_src_path

  dist_bin_path="${dist_bx_path}/$(basename "${BIN_PATH}")"
  dist_man_path="${dist_bx_path}/$(basename "${MAN_PATH}")"
  dist_src_path="${dist_bx_path}/$(basename "${SRC_PATH}")"

  local download_host="${1:-file://${dist_path}}"
  download_host="${download_host%/}"

  set -x

  mkdir -p "${dist_bin_path}"

  _changelog::without_unreleased >"${dist_bx_path}/CHANGELOG.md"
  cp -r "${ROOT_PATH}/LICENSE" \
    "${dist_bx_path}/LICENSE"
  cp -r "${ROOT_PATH}/dist.bashfile" \
    "${dist_bx_path}/Bashfile"
  cp -r "${BIN_PATH}/${bx_name}" \
    "${dist_bin_path}/${bx_name}"
  cp -r "${BIN_PATH}/${bx_name}-update" \
    "${dist_bin_path}/${bx_name}-update"
  cp -r "${BIN_PATH}/${bx_name}-uninstall" \
    "${dist_bin_path}/${bx_name}-uninstall"
  cp -r "${MAN_PATH}" \
    "${dist_man_path}"
  cp -r "${SRC_PATH}" \
    "${dist_src_path}"

  tar -czf "${bx_archive_path}" -C "${dist_path}" "${bx_dirname}"
  rm -rf "${dist_bx_path}"

  sed \
    -e "s/{{__BX_DOWNLOAD_HOST__}}/${download_host//\//\\/}/g" \
    -e "s/^__BX_VERSION__=\$/__BX_VERSION__=${bx_version}/" \
    -e "s/^__BX_DOWNLOAD_HOST__=\$/__BX_DOWNLOAD_HOST__=${download_host//\//\\/}/" \
    "${ROOT_PATH}/install.sh" \
    >"${dist_path}/install.sh"

  (cd "${dist_path}" && _checksum ./* >"${dist_path}/SHA256SUMS")
}

clean-dist() {
  @confirm

  set -x

  rm -rf "${ROOT_PATH}/dist"
}

_checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$@"
  else
    shasum -a 256 "$@"
  fi
}

_doctor::check() {
  local description="$1"
  shift

  printf "Looking for %s... " "${description}"

  if "$@" >/dev/null 2>/dev/null; then
    printf "Found!\n"

    return 0
  fi

  printf "Not found!\n"

  return 1
}

_changelog::without_unreleased() {
  local line
  local in_unreleased=0

  while IFS= read -r line || [[ -n ${line} ]]; do
    case ${line} in
      "## [Unreleased]") in_unreleased=1 ;;
      "## "*)
        in_unreleased=0
        printf "%s\n" "${line}"
        ;;
      "[Unreleased]:"*) ;;
      *) [[ ${in_unreleased} == 1 ]] || printf "%s\n" "${line}" ;;
    esac
  done <"${ROOT_PATH}/CHANGELOG.md"
}
