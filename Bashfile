ROOT_PATH="$(realpath "$(dirname "${BASH_SOURCE[0]}")")"

BIN_PATH="${ROOT_PATH}/bin"
SRC_PATH="${ROOT_PATH}/src"

# shellcheck disable=SC2207
SOURCES=("${BIN_PATH}/bx" $(find "${SRC_PATH=}" -name "*.sh"))

if [[ -f "${ROOT_PATH}/features/Bashfile" ]]; then
  source "${ROOT_PATH}/features/Bashfile"
fi

dist() {
  @help "Prepare downloadable bx archive and installer." \
    "Arguments:" \
    "  download_host - URI of the location where the distribution archive" \
    "                  will be stored (default: file://<repo_path>/dist)."

  bx::invoke clean-dist

  local bx_name="${__BX_CONSTANT_COMMAND_NAME__}"
  local bx_version="${__BX_CONSTANT_VERSION__}"
  local bx_dirname="${bx_name}_${bx_version}"
  local bx_archive_name="${bx_dirname}.tar.gz"

  local dist_path="${ROOT_PATH}/dist"
  local dist_bx_path="${dist_path}/${bx_dirname}"
  local bx_archive_path="${dist_bx_path}.tar.gz"

  local dist_src_path
  local dist_bin_path

  dist_src_path="${dist_bx_path}/$(basename "${SRC_PATH=}")"
  dist_bin_path="${dist_bx_path}/$(basename "${BIN_PATH}")"

  local download_host="${1:-file://${dist_path}}"
  download_host="${download_host%/}"

  local checksum

  set -x

  mkdir -p "${dist_bin_path}"

  cp -r "${ROOT_PATH}/Bashfile" \
    "${dist_bx_path}/Bashfile"
  cp -r "${SRC_PATH=}" \
    "${dist_src_path}"
  cp -r "${BIN_PATH}/${bx_name}" \
    "${dist_bin_path}/${bx_name}"

  tar -czf "${bx_archive_path}" -C "${dist_path}" "${bx_dirname}"

  # shellcheck disable=SC2207
  checksum=($(_checksum "${bx_archive_path}"))

  sed \
    -e "s/{{DOWNLOAD_HOST}}/${download_host//\//\\/}/g" \
    -e "s/^BX_VERSION=\$/BX_VERSION=${bx_version}/" \
    -e "s/^BX_TARBALL_URL=\$/BX_TARBALL_URL=${download_host//\//\\/}\/${bx_archive_name//\//\\/}/" \
    -e "s/^BX_TARBALL_SHA256=\$/BX_TARBALL_SHA256=${checksum[0]}/" \
    "${ROOT_PATH}/install.sh" \
    >"${dist_path}/install.sh"
}

clean-dist() {
  set -x

  rm -rf "${ROOT_PATH}/dist"
}

install() {
  @help "Add '${BIN_PATH/#${HOME}/~}' to binary path from shell config." \
    "Supported shells: sh, dash, bash, zsh, and fish."

  if command -v "${__BX_CONSTANT_COMMAND_NAME__}" &>/dev/null; then
    echo "${__BX_CONSTANT_COMMAND_NAME__} is already installed!" >&2

    exit 1
  fi

  local shell
  local config_path
  local config_content
  local apply_instruction

  shell="$(basename "${SHELL}")"

  case "${shell}" in
    sh | dash)
      config_path="${HOME}/.profile"
      config_content="export PATH=${BIN_PATH}:\${PATH}"
      apply_instruction="export PATH=\"${BIN_PATH}:\${PATH}\""
      ;;

    bash | zsh)
      config_path="${HOME}/.${shell}rc"
      config_content="export PATH=${BIN_PATH}:\${PATH}"
      apply_instruction="export PATH=\"${BIN_PATH}:\${PATH}\""
      ;;

    fish)
      config_path="${HOME}/.config/fish/config.fish"
      config_content="fish_add_path ${BIN_PATH}"
      apply_instruction="fish_add_path \"${BIN_PATH}\""
      ;;

    *)
      echo "Installing to shell '${shell}' is not supported!" >&2

      exit 1
      ;;
  esac

  if ! grep -qsxF "${config_content}" "${config_path}" 2>/dev/null; then
    printf "\n%s" "${config_content}" >>"${config_path}"
  fi

  cat <<-INFO
		${__BX_CONSTANT_COMMAND_NAME__} is installed in ${config_path}

		Execute this in your terminal to use ${__BX_CONSTANT_COMMAND_NAME__} right now:
		  ${apply_instruction}
	INFO
}

# Execute bash linting
lint() {
  local args=("--exclude" "SC1090,SC1091,SC2030,SC2031,SC2329" "$@")

  set -x

  shellcheck --shell bash ${args+"${args[@]}"} "${SOURCES[@]}" "${ROOT_PATH}/install.sh" "${ROOT_PATH}/Bashfile"
}

format() {
  set -x

  # https://google.github.io/styleguide/shellguide.html
  shfmt -i 2 -ci -bn -s -w "${SOURCES[@]}" "${ROOT_PATH}/install.sh" "${ROOT_PATH}/Bashfile"
}

_checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1"
  else
    shasum -a 256 "$1"
  fi
}
